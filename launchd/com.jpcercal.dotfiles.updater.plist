<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jpcercal.dotfiles.updater</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/bash</string>
        <string>/Users/jpcercal/dotfiles/scripts/dotfiles-updater.sh</string>
        <string>--gate</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>21600</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/jpcercal/dotfiles/logs/dotfiles-updater/agent.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jpcercal/dotfiles/logs/dotfiles-updater/agent.err.log</string>
</dict>
</plist>
